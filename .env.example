# Server
PORT=3002

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agro_supply

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Uploads
UPLOAD_PATH=./storage/proofs
PUBLIC_UPLOAD_BASE=/storage/proofs

# Bank statement reconciliation
STATEMENT_PATH=./storage/statements
PUBLIC_STATEMENT_BASE=/storage/statements
# Largest difference between a statement line and the request still settled, as a bank charge
PAYMENT_MATCH_TOLERANCE=25000
# Accounts the statements may belong to (comma-separated). Empty = not checked.
BANK_ACCOUNTS=
# 1 = only the bank's own encrypted export may settle payments. Set 0 only if the
# bank changes its export format and every genuine file starts being refused.
STATEMENT_STRICT=1
